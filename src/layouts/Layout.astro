---
import '../styles/global.css';
import { getDict, locales, localePath, resolveLocale } from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const t = getDict(locale);
const { title, description } = t.meta;

// Restaurant schema for search engines and AI assistants; the numbers match
// the hours in the footer and the rating shown in the hero/reviews.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'Pizza Mania',
  description,
  servesCuisine: 'Neapolitan pizza',
  priceRange: '€',
  telephone: '+39 081 000 0000',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Vico della Mozzarella 17',
    postalCode: '80134',
    addressLocality: 'Napoli',
    addressCountry: 'IT',
  },
  openingHours: ['Tu-Su 12:00-15:00', 'Tu-Su 18:00-23:30'],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '812',
  },
  acceptsReservations: false,
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#b93425" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {locales.map((l) => (
      <link rel="alternate" hreflang={l} href={localePath(l)} />
    ))}
    <link rel="alternate" hreflang="x-default" href="/" />
    <link rel="preload" href="/fonts/anton.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/instrument-serif-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a href="#main" class="skip-link">{t.skipLink}</a>
    <slot />
    <!-- Single polite live region; everything announces through src/lib/announce.ts -->
    <div id="sr-status" role="status" aria-live="polite" class="sr-only"></div>
  </body>
</html>
