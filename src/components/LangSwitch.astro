---
// Segmented language control in the site's poster style: one bordered
// pill, hard shadow, the active language pressed in like a stamped chip.
// Plain links — switching language is a navigation, no JS required.
import {
  getDict,
  locales,
  localePath,
  localeShortLabels,
  dictionaries,
  resolveLocale,
} from '../i18n';

const current = resolveLocale(Astro.currentLocale);
const t = getDict(current);
---

<nav class="lang-switch" aria-label={t.nav.language}>
  {locales.map((locale) => (
    <a
      href={localePath(locale)}
      lang={locale}
      hreflang={locale}
      aria-current={locale === current ? 'page' : undefined}
      title={dictionaries[locale].langName}
    >
      {localeShortLabels[locale]}
      <span class="sr-only"> — {dictionaries[locale].langName}</span>
    </a>
  ))}
</nav>

<style>
  .lang-switch {
    display: inline-flex;
    border: var(--border);
    border-radius: var(--radius);
    background: var(--cream);
    box-shadow: var(--shadow-hard-sm);
    overflow: hidden;
  }

  .lang-switch a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.35rem;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    color: var(--ink);
    text-decoration: none;
  }
  .lang-switch a + a {
    border-left: 2px solid var(--ink);
  }
  .lang-switch a:hover {
    background: var(--paper-deep);
  }
  .lang-switch a[aria-current='page'] {
    background: var(--tomato);
    color: var(--cream);
    /* pressed-in, like the size chips in the builder */
    box-shadow: inset 2px 2px 0 rgba(33, 26, 18, 0.35);
  }
  .lang-switch a:focus-visible {
    outline: 3px solid var(--tomato);
    outline-offset: -3px;
  }
  /* tomato-on-tomato would vanish on the active chip */
  .lang-switch a[aria-current='page']:focus-visible {
    outline-color: var(--ink);
  }
</style>
