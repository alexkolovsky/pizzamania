---
// Two paragraphs of real copy — the "love letter to Neapolitan pizza".
import { getDict } from '../i18n';

const t = getDict(Astro.currentLocale);
---

<section id="story" class="section story" aria-labelledby="story-heading">
  <div class="container story-inner">
    <span class="section-kicker">{t.story.kicker}</span>
    <h2 id="story-heading">{t.story.heading}</h2>
    <p>{t.story.p1}</p>
    <blockquote class="story-quote">
      <p>&ldquo;{t.story.quoteBefore}<em>{t.story.quoteEm}</em>{t.story.quoteAfter}&rdquo;</p>
    </blockquote>
    <p>{t.story.p2}</p>
  </div>
</section>

<style>
  .story {
    background: var(--basil-dark);
    color: var(--paper);
  }
  .story .section-kicker {
    color: var(--mustard);
  }
  .story h2 {
    color: var(--cream);
    font-size: var(--text-2xl);
  }
  .story-inner {
    max-width: 46rem;
  }
  .story p {
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .story-quote {
    margin: var(--space-4) 0;
    padding-left: var(--space-4);
    border-left: 4px solid var(--mustard);
  }
  .story-quote p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    line-height: 1.35;
    color: var(--cream);
    margin: 0;
  }
  .story-quote em {
    color: var(--mustard);
  }
</style>
