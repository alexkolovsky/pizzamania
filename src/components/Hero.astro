---
// Hero pizza reuses the same layer system as the builder: base + two topping
// layers composited with absolutely-positioned images. Floating garnish
// around it reuses the builder tray icons.
import { BASE_LAYER_SRC, ingredientBySlug } from '../data/ingredients';

const heroToppings = ['pomodorini', 'basilico'].map((slug) => ingredientBySlug.get(slug)!);

// Each marquee half is the phrase repeated 4× (~6000px) — wider than any
// viewport, so the -50% loop point is never on screen and the scroll reads
// as seamless everywhere.
const ticker =
  'Forno a legna ✶ Impasto 48h ✶ San Marzano DOP ✶ No ananas (quasi) ✶ Mozzarella di bufala ✶ '.repeat(4);

// Floating garnish: icon, position, bob delay, parallax depth (px at cursor edge)
const garnish = [
  { slug: 'basilico', top: '-2%', left: '-6%', size: 110, delay: '0s', depth: 22 },
  { slug: 'pomodorini', top: '64%', left: '-11%', size: 92, delay: '1.1s', depth: -16 },
  { slug: 'funghi', top: '-10%', left: '56%', size: 100, delay: '0.6s', depth: 18 },
  { slug: 'olive', top: '84%', left: '84%', size: 78, delay: '1.7s', depth: -26 },
  { slug: 'cipolla', top: '36%', left: '94%', size: 90, delay: '2.3s', depth: 14 },
];
---

<section id="top" class="hero" aria-labelledby="hero-heading">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-eyebrow">Pizzeria napoletana &middot; Vico della Mozzarella 17</p>
      <!-- Kinetic reveal: each beat rises in sequence; static under reduced motion -->
      <h1 id="hero-heading">
        <span class="beat" style="--beat: 0">Fire.</span>
        <span class="beat" style="--beat: 1">Flour.</span>
        <em class="beat hero-accent" style="--beat: 2">Amore.</em>
      </h1>
      <p class="hero-sub">
        Ninety seconds in a wood-fired oven, a 48-hour dough, and a chef named Giovanni with
        very strong opinions. Build your own — he'll only interfere a little.
      </p>
      <div class="hero-actions">
        <a href="#builder" class="btn btn-primary hero-cta">Build your pizza</a>
        <a href="#menu" class="hero-menu-link">or trust the menu ↓</a>
      </div>
    </div>

    <div class="hero-visual" id="hero-visual">
      <div class="hero-pizza" role="img" aria-label="A margherita pizza with cherry tomatoes and fresh basil, gently steaming">
        <img src={BASE_LAYER_SRC} alt="" width="512" height="512" fetchpriority="high" />
        {heroToppings.map((topping) => (
          <img class="hero-layer" src={topping.layerSrc} alt="" width="512" height="512" style={`z-index:${topping.z}`} />
        ))}
        <div class="steam" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
      </div>

      <!-- Floating garnish with cursor parallax (decorative) -->
      {garnish.map((g) => (
        <span
          class="garnish"
          style={`top:${g.top}; left:${g.left}; --depth:${g.depth}; --bob-delay:${g.delay}`}
          aria-hidden="true"
        >
          <img src={`/pizza/icons/${g.slug}.svg`} alt="" width={g.size} height={g.size} />
        </span>
      ))}

      <div class="hero-sticker" aria-hidden="true">
        <svg viewBox="0 0 120 120" width="118" height="118">
          <path d="M60 4 L71 16 L87 10 L91 27 L108 28 L104 45 L118 54 L106 66 L114 82 L98 87 L98 104 L81 101 L73 116 L60 106 L47 116 L39 101 L22 104 L22 87 L6 82 L14 66 L2 54 L16 45 L12 28 L29 27 L33 10 L49 16 Z" fill="#e3a63b" stroke="#211a12" stroke-width="3" stroke-linejoin="round"/>
        </svg>
        <span class="hero-sticker-text">Impasto<br />48h!</span>
      </div>
    </div>
  </div>

  <!-- Decorative ticker — pure vibes, hidden from assistive tech -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>{ticker}</span><span>{ticker}</span>
    </div>
  </div>
</section>

<script>
  // Cursor-proximity parallax for the garnish — pointer devices with motion
  // allowed only. One rAF-throttled listener writing two CSS variables.
  const visual = document.getElementById('hero-visual');
  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  const motionOk = matchMedia('(prefers-reduced-motion: no-preference)');

  if (visual && fine.matches && motionOk.matches) {
    let raf = 0;
    visual.addEventListener('pointermove', (event) => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        const rect = visual.getBoundingClientRect();
        const x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
        const y = ((event.clientY - rect.top) / rect.height) * 2 - 1;
        visual.style.setProperty('--px', x.toFixed(3));
        visual.style.setProperty('--py', y.toFixed(3));
      });
    });
    visual.addEventListener('pointerleave', () => {
      visual.style.setProperty('--px', '0');
      visual.style.setProperty('--py', '0');
    });
  }
</script>

<style>
  .hero {
    padding-top: var(--space-5);
    overflow: clip;
    border-bottom: var(--border);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
  }

  .hero-eyebrow {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--tomato-ink);
    margin-bottom: var(--space-2);
  }

  h1 {
    font-size: var(--text-hero);
    margin-bottom: var(--space-3);
  }

  .beat {
    display: inline-block;
    margin-right: 0.14em;
  }
  @media (prefers-reduced-motion: no-preference) {
    .beat {
      animation: beat-rise 0.55s cubic-bezier(0.2, 0.7, 0.3, 1.1) both;
      animation-delay: calc(var(--beat) * 140ms);
    }
    @keyframes beat-rise {
      from {
        opacity: 0;
        transform: translateY(0.5em) rotate(1.5deg);
      }
    }
  }

  .hero-accent {
    font-family: var(--font-serif);
    font-style: italic;
    text-transform: lowercase;
    color: var(--tomato-ink);
    font-size: 1.06em;
    letter-spacing: 0;
  }

  .hero-sub {
    font-size: var(--text-lg);
    color: var(--ink-soft);
    max-width: 38ch;
    margin-bottom: var(--space-4);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hero-cta {
    font-size: var(--text-lg);
    padding: 0.6em 1.4em;
  }

  .hero-menu-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--ink);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .hero-menu-link:hover {
    color: var(--tomato-ink);
  }

  .hero-visual {
    position: relative;
    --px: 0;
    --py: 0;
  }

  .hero-pizza {
    position: relative;
    width: min(30rem, 100%);
    margin-inline: auto;
    aspect-ratio: 1;
    transform: rotate(4deg);
    filter: drop-shadow(10px 14px 0 rgba(33, 26, 18, 0.18));
  }
  .hero-pizza img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Floating garnish: outer span carries cursor parallax, inner img bobs */
  .garnish {
    position: absolute;
    z-index: 5;
    transform: translate3d(
      calc(var(--px) * var(--depth) * 1px),
      calc(var(--py) * var(--depth) * 1px),
      0
    );
    transition: transform 0.35s ease-out;
    filter: drop-shadow(3px 4px 0 rgba(33, 26, 18, 0.16));
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .garnish img {
      animation: garnish-bob 5.5s ease-in-out infinite alternate;
      animation-delay: var(--bob-delay);
    }
    @keyframes garnish-bob {
      from {
        transform: translateY(-7px) rotate(-4deg);
      }
      to {
        transform: translateY(7px) rotate(5deg);
      }
    }
  }

  .hero-sticker {
    position: absolute;
    top: -4%;
    right: 4%;
    z-index: 6;
    display: grid;
    place-items: center;
    transform: rotate(12deg);
    filter: drop-shadow(3px 3px 0 rgba(33, 26, 18, 0.25));
  }
  .hero-sticker svg {
    grid-area: 1 / 1;
  }
  .hero-sticker-text {
    grid-area: 1 / 1;
    font-family: var(--font-display);
    text-transform: uppercase;
    text-align: center;
    font-size: 1.05rem;
    line-height: 1.05;
    color: var(--ink);
  }

  /* Ambient float + steam — decorative only, removed under reduced motion */
  @media (prefers-reduced-motion: no-preference) {
    .hero-pizza {
      animation: hero-float 7s ease-in-out infinite;
    }
    @keyframes hero-float {
      50% {
        transform: rotate(4deg) translateY(-12px);
      }
    }

    .steam span {
      position: absolute;
      bottom: 62%;
      left: 50%;
      width: 14px;
      height: 44px;
      border-radius: 999px;
      background: linear-gradient(to top, transparent, rgba(255, 249, 236, 0.9));
      opacity: 0;
      animation: steam-rise 3.6s ease-in-out infinite;
    }
    .steam span:nth-child(2) {
      left: 40%;
      animation-delay: 1.2s;
    }
    .steam span:nth-child(3) {
      left: 60%;
      animation-delay: 2.4s;
    }
    @keyframes steam-rise {
      0% {
        opacity: 0;
        transform: translateY(20px) scaleY(0.6);
      }
      35% {
        opacity: 0.8;
      }
      100% {
        opacity: 0;
        transform: translateY(-70px) scaleY(1.2) translateX(8px);
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .steam {
      display: none;
    }
    .garnish {
      transition: none;
      transform: none;
    }
  }

  /* Ticker strip */
  .marquee {
    background: var(--tomato);
    border-top: var(--border);
    overflow: hidden;
    padding-block: 0.55rem;
  }
  .marquee-track {
    display: flex;
    width: max-content;
    white-space: nowrap;
  }
  .marquee-track span {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: var(--text-lg);
    letter-spacing: 0.06em;
    color: var(--cream);
    padding-right: 0.5em;
  }
  @media (prefers-reduced-motion: no-preference) {
    .marquee-track {
      animation: marquee 24s linear infinite;
      will-change: transform;
    }
    @keyframes marquee {
      to {
        transform: translateX(-50%);
      }
    }
  }

  @media (max-width: 52rem) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-sub {
      margin-inline: auto;
    }
    .hero-actions {
      justify-content: center;
    }
    .hero-sticker {
      right: 0;
    }
    .garnish {
      display: none;
    }
  }
</style>
