---
// Sticky nav. The cart badge lives OUTSIDE the Svelte island: a plain script
// below subscribes to the shared nanostores, proving state crosses the
// island boundary in both directions.
---

<header class="site-header">
  <nav class="container nav" aria-label="Main">
    <a href="#top" class="logo">
      <svg class="logo-mark" viewBox="0 0 64 64" width="30" height="30" aria-hidden="true">
        <path d="M32 6 L58 54 Q32 66 6 54 Z" fill="#e3a63b" stroke="#211a12" stroke-width="3" stroke-linejoin="round"/>
        <path d="M32 16 L50 50 Q32 57 14 50 Z" fill="#c93a22"/>
        <circle cx="32" cy="34" r="4.5" fill="#f6eedf"/>
        <circle cx="26" cy="45" r="3.5" fill="#f6eedf"/>
        <circle cx="39" cy="45" r="3.5" fill="#3a5a2e"/>
      </svg>
      Pizza<span class="logo-accent">Mania</span>
    </a>
    <ul class="nav-links">
      <li><a href="#menu">Menu</a></li>
      <li><a href="#builder">Builder</a></li>
      <li><a href="#story">Story</a></li>
    </ul>
    <button type="button" class="cart-button" id="nav-cart-button" aria-haspopup="dialog">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="9" cy="21" r="1.5"></circle>
        <circle cx="18" cy="21" r="1.5"></circle>
        <path d="M2.5 3h2l2.7 12.4a1.8 1.8 0 0 0 1.8 1.4h8.6a1.8 1.8 0 0 0 1.8-1.4L21.5 7H6"></path>
      </svg>
      <span>Order</span>
      <span class="cart-badge" id="nav-cart-badge" hidden aria-hidden="true">0</span>
      <span class="sr-only" id="nav-cart-count-label">, 0 pizzas in order</span>
    </button>
  </nav>
</header>

<script>
  import { cartCount, isCartOpen } from '../stores/cart';

  const button = document.getElementById('nav-cart-button')!;
  const badge = document.getElementById('nav-cart-badge')!;
  const label = document.getElementById('nav-cart-count-label')!;

  cartCount.subscribe((count) => {
    badge.textContent = String(count);
    badge.hidden = count === 0;
    label.textContent = `, ${count} ${count === 1 ? 'pizza' : 'pizzas'} in order`;
    // Tiny pop when the count changes (decorative, motion-safe)
    if (count > 0 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      badge.classList.remove('pop');
      void badge.offsetWidth; // restart the animation
      badge.classList.add('pop');
    }
  });

  button.addEventListener('click', () => isCartOpen.set(true));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--paper);
    border-bottom: var(--border);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--nav-height);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
  }
  .logo-mark {
    transform: rotate(-8deg);
  }
  .logo-accent {
    color: var(--tomato-ink);
  }

  .nav-links {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.9rem;
    color: var(--ink);
    font-weight: 700;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    border-bottom: 3px solid transparent;
  }
  .nav-links a:hover {
    color: var(--tomato-ink);
    border-bottom-color: var(--tomato);
  }

  .cart-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1.1rem;
    border: var(--border);
    border-radius: var(--radius);
    background: var(--tomato);
    color: var(--cream);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    box-shadow: var(--shadow-hard-sm);
  }
  .cart-button:hover {
    background: var(--tomato-dark);
  }
  .cart-button:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--ink);
  }

  .cart-badge {
    position: absolute;
    top: -10px;
    right: -10px;
    min-width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--cream);
    font-size: 0.8rem;
    font-weight: 800;
    border: 2px solid var(--paper);
  }
  .cart-badge[hidden] {
    display: none;
  }
  .cart-badge.pop {
    animation: badge-pop 0.35s ease;
  }
  @keyframes badge-pop {
    50% {
      transform: scale(1.35);
    }
  }

  @media (max-width: 40rem) {
    .nav {
      gap: var(--space-2);
    }
    .nav-links a {
      padding: 0 0.5rem;
    }
  }
</style>
