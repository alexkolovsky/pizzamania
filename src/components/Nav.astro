---
// Sticky nav. The cart badge lives OUTSIDE the Svelte island: a plain script
// below subscribes to the shared nanostores, proving state crosses the
// island boundary in both directions. On narrow screens the links collapse
// behind a disclosure hamburger (aria-expanded pattern, no focus trap needed).
// The language switch renders twice: inline on desktop, inside the
// disclosure menu on mobile — only one is ever displayed.
import LangSwitch from './LangSwitch.astro';
import { getDict } from '../i18n';

const t = getDict(Astro.currentLocale);
---

<header class="site-header">
  <nav class="container nav" id="site-nav" aria-label={t.nav.mainLabel}>
    <a href="#top" class="logo">
      <svg class="logo-mark" viewBox="0 0 64 64" width="30" height="30" aria-hidden="true">
        <path d="M32 6 L58 54 Q32 66 6 54 Z" fill="#e3a63b" stroke="#211a12" stroke-width="3" stroke-linejoin="round"/>
        <path d="M32 16 L50 50 Q32 57 14 50 Z" fill="#c93a22"/>
        <circle cx="32" cy="34" r="4.5" fill="#f6eedf"/>
        <circle cx="26" cy="45" r="3.5" fill="#f6eedf"/>
        <circle cx="39" cy="45" r="3.5" fill="#3a5a2e"/>
      </svg>
      Pizza<span class="logo-accent">Mania</span>
    </a>

    <button
      type="button"
      class="menu-toggle"
      id="nav-menu-toggle"
      aria-expanded="false"
      aria-controls="site-menu"
    >
      <span class="menu-toggle-box" aria-hidden="true">
        <span class="menu-toggle-bar"></span>
        <span class="menu-toggle-bar"></span>
        <span class="menu-toggle-bar"></span>
      </span>
      <span class="sr-only">{t.nav.menuToggle}</span>
    </button>

    <ul class="nav-links" id="site-menu">
      <li><a href="#menu">{t.nav.menu}</a></li>
      <li><a href="#builder">{t.nav.builder}</a></li>
      <li><a href="#story">{t.nav.story}</a></li>
      <li class="lang-mobile"><LangSwitch /></li>
    </ul>

    <div class="lang-desktop"><LangSwitch /></div>

    <button type="button" class="cart-button" id="nav-cart-button" aria-haspopup="dialog" aria-expanded="false">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="9" cy="21" r="1.5"></circle>
        <circle cx="18" cy="21" r="1.5"></circle>
        <path d="M2.5 3h2l2.7 12.4a1.8 1.8 0 0 0 1.8 1.4h8.6a1.8 1.8 0 0 0 1.8-1.4L21.5 7H6"></path>
      </svg>
      <span class="cart-label">{t.nav.order}</span>
      <span class="cart-badge" id="nav-cart-badge" hidden aria-hidden="true">0</span>
      <span class="sr-only" id="nav-cart-count-label">{t.nav.cartCountSr(0)}</span>
    </button>
  </nav>
</header>

<script>
  import { cartCount, isCartOpen } from '../stores/cart';
  import { t } from '../i18n/runtime';

  const button = document.getElementById('nav-cart-button')!;
  const badge = document.getElementById('nav-cart-badge')!;
  const label = document.getElementById('nav-cart-count-label')!;

  cartCount.subscribe((count) => {
    badge.textContent = String(count);
    badge.hidden = count === 0;
    label.textContent = t().nav.cartCountSr(count);
    // Tiny pop when the count changes (decorative, motion-safe)
    if (count > 0 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      badge.classList.remove('pop');
      void badge.offsetWidth; // restart the animation
      badge.classList.add('pop');
    }
  });

  button.addEventListener('click', () => isCartOpen.set(true));
  isCartOpen.subscribe((open) => button.setAttribute('aria-expanded', String(open)));

  /* ---- Mobile disclosure menu ---- */
  const nav = document.getElementById('site-nav')!;
  const toggle = document.getElementById('nav-menu-toggle')!;
  const menu = document.getElementById('site-menu')!;
  // 56em matches the builder's stacking breakpoint; below it the inline
  // nav (longest in Ukrainian/Italian) plus the language switch overflows.
  const desktop = matchMedia('(min-width: 56em)');

  function setOpen(open: boolean) {
    nav.toggleAttribute('data-open', open);
    toggle.setAttribute('aria-expanded', String(open));
  }

  toggle.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // Anchor navigation should close the menu so it doesn't cover the target
  menu.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  document.addEventListener('click', (event) => {
    if (
      toggle.getAttribute('aria-expanded') === 'true' &&
      !nav.contains(event.target as Node)
    ) {
      setOpen(false);
    }
  });

  // Crossing into the desktop layout always resets the disclosure state
  desktop.addEventListener('change', () => setOpen(false));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--paper);
    border-bottom: var(--border);
    padding-inline: env(safe-area-inset-left) env(safe-area-inset-right);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--nav-height);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
    white-space: nowrap;
  }
  .logo-mark {
    transform: rotate(-8deg);
    flex-shrink: 0;
  }
  .logo-accent {
    color: var(--tomato-ink);
  }

  .nav-links {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.9rem;
    color: var(--ink);
    font-weight: 700;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    border-bottom: 3px solid transparent;
  }
  .nav-links a:hover {
    color: var(--tomato-ink);
    border-bottom-color: var(--tomato);
  }

  /* Language switch: inline instance on desktop, menu instance on mobile */
  .lang-mobile {
    display: none;
  }

  /* Hamburger — hidden on desktop */
  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    place-items: center;
    border: var(--border);
    border-radius: var(--radius);
    background: var(--cream);
    box-shadow: var(--shadow-hard-sm);
    cursor: pointer;
    order: 3;
  }
  .menu-toggle:active {
    transform: translate(2px, 2px);
    box-shadow: none;
  }
  .menu-toggle-box {
    display: grid;
    gap: 4.5px;
    width: 20px;
  }
  .menu-toggle-bar {
    height: 3px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle-bar:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle-bar:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-toggle-bar {
      transition: none;
    }
  }

  .cart-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1.1rem;
    border: var(--border);
    border-radius: var(--radius);
    background: var(--tomato);
    color: var(--cream);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    box-shadow: var(--shadow-hard-sm);
    order: 2;
  }
  .cart-button:hover {
    background: var(--tomato-dark);
  }
  .cart-button:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--ink);
  }

  .cart-badge {
    position: absolute;
    top: -10px;
    right: -10px;
    min-width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--cream);
    font-size: 0.8rem;
    font-weight: 800;
    border: 2px solid var(--paper);
  }
  .cart-badge[hidden] {
    display: none;
  }
  .cart-badge.pop {
    animation: badge-pop 0.35s ease;
  }
  @keyframes badge-pop {
    50% {
      transform: scale(1.35);
    }
  }

  /* ---- Collapsed layout ---- */
  @media (max-width: 55.99em) {
    .menu-toggle {
      display: grid;
    }

    /* Anchored to the sticky header (nearest positioned ancestor), so the
       dropdown spans the full header width without any 100vw overflow */
    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: var(--paper);
      border-bottom: var(--border);
      padding: var(--space-2) var(--space-3) var(--space-3);
      box-shadow: 0 12px 24px rgba(33, 26, 18, 0.15);
    }
    .nav[data-open] .nav-links {
      display: flex;
    }
    @media (prefers-reduced-motion: no-preference) {
      .nav[data-open] .nav-links {
        animation: menu-drop 0.2s ease;
      }
      @keyframes menu-drop {
        from {
          opacity: 0;
          transform: translateY(-8px);
        }
      }
    }

    .nav-links a {
      width: 100%;
      min-height: 48px;
      font-size: var(--text-base);
      border-bottom: 2px solid var(--paper-deep);
    }
    .nav-links li:last-child a {
      border-bottom-color: transparent;
    }
    .nav-links a:hover {
      border-bottom-color: var(--tomato);
    }

    .lang-desktop {
      display: none;
    }
    .lang-mobile {
      display: block;
      padding-top: var(--space-3);
    }

    /* Icon-only Order button frees space for the logo; the label stays in
       the accessibility tree (sr-only style, not display:none) */
    .cart-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .cart-button {
      width: 44px;
      padding: 0;
      justify-content: center;
    }
  }

  @media (max-width: 22em) {
    .logo {
      font-size: 1.15rem;
    }
  }
</style>
