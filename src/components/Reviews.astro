---
// Social proof between the builder and the story: short reviews and an
// aggregate line. Static copy, same trattoria art direction as the menu.
import { getDict } from '../i18n';

const t = getDict(Astro.currentLocale);

const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part.replace(/[^\p{L}]/gu, '').charAt(0))
    .join('')
    .toUpperCase();
---

<section class="section reviews" aria-labelledby="reviews-heading">
  <div class="container">
    <span class="section-kicker" lang="it">{t.reviews.kicker}</span>
    <h2 id="reviews-heading">{t.reviews.heading}</h2>
    <p class="reviews-aggregate">
      <span class="reviews-stars" aria-hidden="true">★★★★★</span>
      <span class="sr-only">{t.reviews.ratedSr}</span>
      <strong>4.9 / 5</strong> {t.reviews.aggregate}
    </p>

    <ul class="reviews-grid" role="list">
      {t.reviews.quotes.map((review) => (
        <li class="review-card">
          <p class="review-stars" aria-hidden="true">
            <span>{'★'.repeat(review.stars)}</span><span class="review-stars-empty">{'☆'.repeat(5 - review.stars)}</span>
          </p>
          <span class="sr-only">{t.reviews.starsSr(review.stars)}</span>
          <blockquote class="review-quote">
            <p>&ldquo;{review.quote}&rdquo;</p>
          </blockquote>
          <p class="review-byline">
            <span class="review-avatar" aria-hidden="true">{initials(review.name)}</span>
            <span class="review-who">
              {review.name} <span class="review-place">· {review.place}</span>
            </span>
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .reviews {
    border-top: var(--border);
  }

  .reviews-aggregate {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--ink-soft);
    margin-bottom: var(--space-5);
  }
  .reviews-stars,
  .review-stars {
    color: var(--mustard-deep);
    letter-spacing: 0.1em;
    margin-right: 0.35em;
    text-shadow: 1px 1px 0 var(--ink);
  }
  .reviews-aggregate strong {
    color: var(--ink);
  }

  .reviews-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: var(--space-4);
  }

  .review-card {
    display: flex;
    flex-direction: column;
    background: var(--cream);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-hard);
    padding: var(--space-4);
    transform: rotate(-0.6deg);
    transition: transform 160ms ease;
  }
  .review-card:nth-child(2) {
    transform: rotate(0.7deg);
  }
  .review-card:nth-child(3) {
    transform: rotate(-0.4deg);
  }
  .review-card:nth-child(4) {
    transform: rotate(0.5deg);
  }
  .review-card:hover {
    transform: rotate(0deg) translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .review-card {
      transition: none;
    }
    .review-card:hover {
      transform: none;
    }
  }

  .review-stars {
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
  }

  .review-quote {
    margin: 0 0 var(--space-3);
    flex: 1;
  }
  .review-quote p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-lg);
    line-height: 1.4;
    margin: 0;
  }

  .review-byline {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0;
  }
  .review-avatar {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: var(--border);
    background: var(--mustard);
    color: var(--ink);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    box-shadow: 1px 1px 0 var(--ink);
  }
  .review-card:nth-child(even) .review-avatar {
    background: var(--tomato);
    color: var(--cream);
  }
  .review-place {
    color: var(--ink-soft);
  }
  .review-stars-empty {
    color: var(--ink-soft);
    text-shadow: none;
  }
</style>
